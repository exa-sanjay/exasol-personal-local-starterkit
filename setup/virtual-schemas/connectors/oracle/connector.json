{
  "schema_version": 1,
  "id": "oracle",
  "label": "Oracle",
  "aliases": ["oracle-db", "ora"],
  "adapter": {
    "repo": "exasol/oracle-virtual-schema",
    "version": "5.0.2",
    "file": "virtual-schema-dist-14.0.5-oracle-5.0.2.jar",
    "url": "https://github.com/exasol/oracle-virtual-schema/releases/download/5.0.2/virtual-schema-dist-14.0.5-oracle-5.0.2.jar",
    "sha256_url": "https://github.com/exasol/oracle-virtual-schema/releases/download/5.0.2/virtual-schema-dist-14.0.5-oracle-5.0.2.jar.sha256",
    "sha256": "e5b273704cd94b9ab9d301624e872384dbd64f9013f807ee9e8fa2d0b4274285",
    "license": "MIT"
  },
  "driver": {
    "name": "Oracle JDBC (ojdbc8)",
    "version": "23.26.3.0.0",
    "file": "ojdbc8-23.26.3.0.0.jar",
    "url": "https://repo.maven.apache.org/maven2/com/oracle/database/jdbc/ojdbc8/23.26.3.0.0/ojdbc8-23.26.3.0.0.jar",
    "sha1_url": "https://repo.maven.apache.org/maven2/com/oracle/database/jdbc/ojdbc8/23.26.3.0.0/ojdbc8-23.26.3.0.0.jar.sha1",
    "sha256": "e568862d2f8ff043b86cda4a2ea896437ae9354ece60a2242ce38fdda9ccc52a",
    "license": "Oracle Free Use Terms and Conditions (FUTC)",
    "bundled_in_adapter": false,
    "settings": {
      "DRIVERNAME": "EXAKIT_ORACLE",
      "PREFIX": "jdbc:oracle:thin:",
      "DRIVERMAIN": "oracle.jdbc.driver.OracleDriver",
      "FETCHSIZE": "100000",
      "INSERTSIZE": "-1",
      "NOSECURITY": "YES"
    }
  },
  "script": {
    "class": "com.exasol.adapter.RequestDispatcher",
    "jvm_options": ["-Duser.timezone=UTC"]
  },
  "url": {
    "scheme": "jdbc:oracle:thin:@",
    "default_port": 1521,
    "allowed_params": ["oracle.net.CONNECT_TIMEOUT", "oracle.jdbc.ReadTimeout"],
    "secret_params": ["password", "oracle.net.wallet_password", "javax.net.ssl.trustStorePassword"]
  },
  "inputs": [
    {"id": "host", "label": "Host", "required": true},
    {"id": "port", "label": "Port", "type": "port", "default": 1521},
    {"id": "database", "label": "Service name", "required": true, "example": "FREEPDB1"},
    {"id": "user", "label": "User", "required": true},
    {"id": "password", "label": "Password", "secret": true, "required": true},
    {"id": "schema", "label": "Schema (owner)", "required": true, "connection": false}
  ],
  "properties": {
    "SCHEMA_NAME": "{schema|upper}"
  },
  "tls": {
    "default": "encrypt",
    "levels": {
      "verify": {
        "params": {},
        "available": false,
        "reason": "Oracle TCPS needs a trust store, which Exasol Personal's import process does not have yet."
      },
      "encrypt": {"params": {"oracle.net.encryption_client": "REQUIRED", "oracle.net.crypto_checksum_client": "REQUIRED"}},
      "none": {"params": {}}
    }
  },
  "check": {
    "statement": "SELECT 1 FROM dual",
    "schema": "SELECT CASE WHEN EXISTS (SELECT 1 FROM all_users WHERE username = {schema|upper}) THEN 'ok' ELSE 'missing' END FROM dual"
  },
  "notes": [
    "\"Encrypted\" here is Oracle Native Network Encryption on the normal port, negotiated by driver and server; TCPS is not possible yet.",
    "Oracle names are upper case unless created quoted: the schema is upper-cased for you; tables appear as Oracle stores them."
  ]
}
